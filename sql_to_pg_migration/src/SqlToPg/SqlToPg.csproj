<Project Sdk="Microsoft.NET.Sdk">

  <!-- sql_to_pg_migration: a standalone SQL Server -> PostgreSQL table/column mapper and bulk loader. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sql_to_pg_migration</AssemblyName>
    <RootNamespace>SqlToPg</RootNamespace>
    <!-- Must stay false: Microsoft.Data.SqlClient throws "Globalization Invariant Mode is not supported" on connect. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pinned above the vulnerable versions SqlClient brings transitively (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlToPg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server's 0001-01-01 / 9999-12-31 are real values; keep Npgsql from turning them into -infinity / infinity. -->
    <RuntimeHostConfigurationOption Include="Npgsql.DisableDateTimeInfinityConversions" Value="true" />
  </ItemGroup>

</Project>
