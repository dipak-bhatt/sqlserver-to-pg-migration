; Copy to credentials_dev.ini and fill in. credentials_dev.ini is git-ignored.

; MSSQL environment settings
[mssql]
sql_host = <sql-server-host>
sql_user = <sql-user>
sql_pass = <sql-password>

; PostgreSQL environment settings
[postgres]
pg_user = <pg-user>
pg_pass = <pg-password>
pg_host = localhost
pg_port = 5432
target_db = <target-db>
